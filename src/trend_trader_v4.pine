//@version=4
strategy("Trend Trader Strategy (v4 filters + exits + swing stop)", shorttitle="TT Strat",
     overlay=true, initial_capital=10000,
     default_qty_type=strategy.percent_of_equity, default_qty_value=10, pyramiding=0)

// ===== Inputs =====
showBuySell   = input(true,  title="Show Buy/Sell Labels")
src           = input(close, title="Source")

// MACD
fast_length   = input(12,  title="Fast Length")
slow_length   = input(26,  title="Slow Length")
signal_length = input(9,   title="Signal Smoothing")

// ADX
adxlen     = input(14,  title="ADX Length")
dilen      = input(14,  title="DI Length")
adx_thresh = input(25.0,title="ADX Threshold")

// ---- ENTRY FILTERS ----
useTrendFilter   = input(true,  title="Use Trend Filter (Close>EMAfast>EMAslow)")
emaFastLen       = input(21,    title="Trend EMA Fast")
emaSlowLen       = input(50,    title="Trend EMA Slow")

requireAdxRising = input(true,  title="Require ADX Rising (sig>sig[1])")
confirmBars      = input(3,     title="Breakout Confirm Bars (close > highest(high,N)[1])", minval=1)
cooldownBars     = input(10,    title="Entry Cooldown (bars) after exit", minval=0)

// ---- EXIT MODES (event-based) ----
exitMode = input(title="Exit Mode", defval="Opposite Sell",
     options=["Opposite Sell","MACD CrossDown","Histogram Zero Cross","ADX Falls Below Threshold","None"])

// ---- PROTECTIVE STOPS (independent) ----
useSwingStop   = input(true,  title="Enable Swing-Low Stop")
swingLen       = input(10,    title="Swing Lookback (bars)")
swingBufPerc   = input(0.20,  title="Swing Buffer % (below low)", step=0.05, minval=0.0)

useSLTP        = input(true,  title="Use Static SL/TP")
slPerc         = input(0.0,   title="Static Stop Loss %", step=0.1, minval=0.0)
tpPerc         = input(0.0,   title="Take Profit %",     step=0.1, minval=0.0)

// ===== MACD =====
fast_ma = ema(src, fast_length)
slow_ma = ema(src, slow_length)
macd    = fast_ma - slow_ma
signal  = ema(macd, signal_length)
hist    = macd - signal

// ===== ADX =====
dirmov(len) =>
    up = change(close)
    down = -change(close)
    plusDM  = na(up)   ? na : (up   > down and up   > 0 ? up   : 0)
    minusDM = na(down) ? na : (down > up   and down > 0 ? down : 0)
    truerange = rma(tr, len)
    plus  = fixnan(100 * rma(plusDM,  len) / truerange)
    minus = fixnan(100 * rma(minusDM, len) / truerange)
    [plus, minus]

adx(diLen, adxLen) =>
    [plus, minus] = dirmov(diLen)
    sum = plus + minus
    100 * rma(abs(plus - minus) / (sum == 0 ? 1 : sum), adxLen)

sig = adx(dilen, adxlen)

// ===== ENTRY SIGNAL + FILTERS =====
macd_crossup        = macd < 0 and crossover(macd, signal)

trendOK = not useTrendFilter or (close > ema(src, emaFastLen) and ema(src, emaFastLen) > ema(src, emaSlowLen))
adxOK   = (sig > adx_thresh) and (not requireAdxRising or sig > sig[1])
breakOK = close > highest(high, confirmBars)[1]

// cooldown від останнього закриття
var int lastExitBar = na
canEnterByCooldown = na(lastExitBar) or (bar_index - lastExitBar >= cooldownBars)

// фінальний дозвіл на вхід
bullish = macd_crossup and adxOK and trendOK and breakOK and canEnterByCooldown

// для довідки (чому не зайшло) можна увімкнути ці плоти у Data Window:
plotchar(bullish, title="Bullish All Filters", char="B", location=location.bottom, transp=100)
plotchar(trendOK, title="Trend OK", char="T", location=location.bottom, transp=100)
plotchar(adxOK,   title="ADX OK",   char="A", location=location.bottom, transp=100)
plotchar(breakOK, title="Break OK", char="K", location=location.bottom, transp=100)

// ===== ENTRY / LABELS =====
if (bullish and strategy.position_size == 0)
    strategy.entry("Long", strategy.long)

plotshape(bullish and showBuySell and strategy.position_size==0, title="Buy", text="Buy",
     color=color.lime, style=shape.labelup, location=location.belowbar, size=size.tiny, textcolor=color.black)

// ===== EXIT (event-based) =====
macd_crossdown      = macd > 0 and crossover(signal, macd)
hist_crossdown_zero = crossunder(hist, 0)
bearish             = sig > adx_thresh and macd_crossdown

exitByOpposite = exitMode == "Opposite Sell"             and bearish
exitByMacdDown = exitMode == "MACD CrossDown"            and macd_crossdown
exitByHistZero = exitMode == "Histogram Zero Cross"      and hist_crossdown_zero
exitByAdxDrop  = exitMode == "ADX Falls Below Threshold" and (sig < adx_thresh)

if (strategy.position_size > 0 and (exitByOpposite or exitByMacdDown or exitByHistZero or exitByAdxDrop))
    strategy.close("Long", comment="Exit: " + exitMode)

// ===== PROTECTIVE STOPS =====
longPrice   = strategy.position_avg_price
staticSL    = (useSLTP and slPerc > 0) ? longPrice * (1 - slPerc/100.0) : na
tpPrice     = (useSLTP and tpPerc > 0) ? longPrice * (1 + tpPerc/100.0) : na

swingLow        = lowest(low, swingLen)
swingStopLong   = useSwingStop ? swingLow * (1.0 - swingBufPerc/100.0) : na

var float combinedStop = na
combinedStop := not na(staticSL) ? staticSL : na
combinedStop := not na(swingStopLong) ? (na(combinedStop) ? swingStopLong : max(combinedStop, swingStopLong)) : combinedStop

if (strategy.position_size > 0 and (useSLTP or useSwingStop))
    strategy.exit("LX", from_entry="Long", stop=combinedStop, limit=tpPrice)

// запам’ятовуємо момент виходу — для cooldown
justClosed = strategy.closedtrades > 0 and strategy.closedtrades[1] < strategy.closedtrades
if (justClosed)
    lastExitBar := bar_index

// ===== Bar color (візуал) =====
ema1 = 50
usedEma = ema(close, ema1)
emaUpColor()   => hlc3 >= usedEma
emaDownColor() => hlc3  < usedEma
barcolor(emaUpColor() ? color.lime : emaDownColor() ? color.red : na)
